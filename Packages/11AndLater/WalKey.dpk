package WalKey;

{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION OFF}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES ON}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE DEBUG}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'WalKey - Pluggable Key-Value Stores for Delphi'}
{$LIBSUFFIX AUTO}
{$RUNONLY}
{$IMPLICITBUILD OFF}

requires
  rtl;

contains
  WalKey.Core in '..\..\Source\WalKey.Core.pas',
  WalKey.Stores.Memory in '..\..\Source\WalKey.Stores.Memory.pas',
  WalKey.Stores.FileTree in '..\..\Source\WalKey.Stores.FileTree.pas',
  WalKey.Stores.Null in '..\..\Source\WalKey.Stores.Null.pas',
  WalKey.Wrappers in '..\..\Source\WalKey.Wrappers.pas',
  WalKey.Adapters.Entity in '..\..\Source\WalKey.Adapters.Entity.pas';

end.
